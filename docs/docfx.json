{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Emissary/Emissary.csproj",
            "Emissary.Testing/Emissary.Testing.csproj",
            "Emissary.AspNetCore/Emissary.AspNetCore.csproj",
            "Emissary.Mcp/Emissary.Mcp.csproj",
            "Emissary.Sqlite/Emissary.Sqlite.csproj",
            "Emissary.Extensions.AI/Emissary.Extensions.AI.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}"], "exclude": ["_site/**", "adr/**"] },
      { "files": ["adr/*.md"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Emissary",
      "_appTitle": "Emissary — production-grade Claude agents for .NET",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}
