<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standing regression test for the zero-reflection claim: this app publishes as
       Native AOT and is executed in CI. If the generator ever emits reflection-dependent
       code, this build breaks. Not a unit-test project — it has no test framework. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Emissary\Emissary.csproj" />
    <ProjectReference Include="..\..\src\Emissary.SourceGenerators\Emissary.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
